# Lucia Engine — environment configuration
# Copy to .env and fill in values for local development.

# PostgreSQL (TimescaleDB) connection string
DATABASE_URL=postgresql://lucia:lucia@localhost:5432/lucia

# Redis connection URL (used by BullMQ job queues)
REDIS_URL=redis://localhost:6379

# MQTT broker connection URL
MQTT_URL=mqtt://localhost:1883

# Path to Hyperledger Fabric connection profile JSON
FABRIC_PROFILE=./chain/network/profiles/connection-org1.json

# Runtime environment: development | test | production
NODE_ENV=development

# Pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# HTTP listen port
PORT=3000

# AWS region (used by load-test client in wk6+)
AWS_REGION=ap-northeast-2
