{
  "name": "@lucia/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/sensible": "^5.6.0",
    "@fastify/websocket": "^10.0.1",
    "@lucia/contracts": "workspace:*",
    "@lucia/db": "workspace:*",
    "bullmq": "^5.34.8",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "fabric-network": "^2.2.20",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.1",
    "mqtt": "^5.10.1",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
