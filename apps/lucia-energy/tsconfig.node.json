{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "composite": true,
    "outDir": "./dist/node",
    "tsBuildInfoFile": "./dist/.tsbuildinfo.node"
  },
  "include": ["vite.config.ts"]
}
