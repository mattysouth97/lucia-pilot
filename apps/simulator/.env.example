# Lucia Simulator — environment configuration
# Copy to .env and fill in values for local development.

# MQTT broker connection URL
MQTT_URL=mqtt://localhost:1883

# Number of buildings to simulate.
# P0 default: 1 (publishes ULJN-001 only).
# wk4 ramps this to 116 for full-scale load testing.
BUILDING_COUNT=1

# Interval between generation ticks per building (milliseconds).
# Default: 60000 (1 minute, matching real inverter reporting cadence).
TICK_INTERVAL_MS=60000

# Pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Set to 'true' to enable deterministic solar output (noiseRatio=0).
# Useful for demo storyboards where repeatable kWh values are required.
# DETERMINISTIC_MODE=false
