# Copy to .env.local and fill in. .env.local is gitignored; .env.example is
# checked in as the contract.

# VWORLD (국토지리정보원) basemap + 3D 건물 layer.
# Get a key at https://www.vworld.kr → 마이페이지 → 인증키 발급.
# Register `localhost` for dev and your prod domain for release.
VITE_VWORLD_KEY=00000000-0000-0000-0000-000000000000

# Mapbox public access token (pk.*).
# Get one at https://account.mapbox.com → Access tokens.
# Restrict by allowed URL in the Mapbox dashboard for production.
VITE_MAPBOX_TOKEN=pk.your_token_here
