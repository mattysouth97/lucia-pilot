# Copy to .env.local and fill in. .env.local is gitignored; .env.example is
# checked in as the contract.

# VWORLD (국토지리정보원) basemap + 3D 건물 layer.
# Get a key at https://www.vworld.kr → 마이페이지 → 인증키 발급.
# Register `localhost` for dev and your prod domain for release.
VITE_VWORLD_KEY=00000000-0000-0000-0000-000000000000

# Mapbox public access token (pk.*).
# Get one at https://account.mapbox.com → Access tokens.
# Restrict by allowed URL in the Mapbox dashboard for production.
VITE_MAPBOX_TOKEN=pk.your_token_here

# Cross-link to the LuciaEnergy B2B platform landing (apps/lucia-energy).
# Defaults to dev port 3002; set to https://energy.lucia.kr (or path-prefixed
# domain) in prod once apps/lucia-energy is deployed.
VITE_LUCIA_ENERGY_URL=http://localhost:3002

# Kakao Maps JS SDK key — FR-O-005 후보지 지도 (v1.3).
# Per FRD risk R-V13-2, this is intentionally optional during the Pilot
# v1.3 demo: when missing, the /map route falls back to mapbox-gl with the
# 116-building generator. To enable Kakao admin-boundary tiles, register a
# JS app at https://developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키.
# Allowed domains must include `localhost` for dev and your prod hostname.
VITE_KAKAO_MAPS_API_KEY=
