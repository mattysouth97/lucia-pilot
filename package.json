{
  "name": "lucia-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "Lucia Pilot Prototype — LH-Uljin 116동 / 3MW 가상공유거래 정산 플랫폼 (FRD-2026-001)",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --parallel build",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r --parallel lint",
    "test": "pnpm -r --parallel test",
    "test:fixtures": "pnpm --filter @lucia/contracts test:fixtures",
    "test:integration:all": "pnpm --filter @lucia/engine test:integration",
    "dev": "pnpm -r --parallel dev",
    "db:migrate": "pnpm --filter @lucia/db migrate",
    "db:seed": "pnpm --filter @lucia/db seed",
    "chain:hello": "bash chain/network/scripts/hello-world.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r --parallel clean && rm -rf node_modules"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-query-devtools": "^5.100.6",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "recharts": "^2.15.4",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import-x": "^4.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
